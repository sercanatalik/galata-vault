{
  "suite": "galata-vault test vectors",
  "protocol": 2,
  "construct": "children",
  "spec": "records.md#5",
  "generator": "scripts/vectors (independent Python: stdlib, cryptography, PyNaCl; age and BLAKE3 written out)",
  "cases": [
    {
      "id": "children-001",
      "description": "three children, sorted by segment, compact JSON",
      "spec": "records.md#5.1",
      "op": "encode",
      "inputs": {
        "children": [
          {
            "seg": "staging",
            "created_at": 1757500200,
            "mode": {
              "kind": "derived"
            }
          },
          {
            "seg": "dev",
            "created_at": 1757500100,
            "mode": {
              "kind": "derived"
            }
          },
          {
            "seg": "eu",
            "created_at": 1757500300,
            "mode": {
              "kind": "sealed",
              "key_ct": "Lz65J3gKm8viFKdOxt2tMwd2YhL2Hqx6DiQ55Pbp0V0"
            }
          }
        ]
      },
      "expect": "success",
      "outputs": {
        "plaintext": "{\"v\":1,\"children\":[{\"seg\":\"dev\",\"created_at\":1757500100,\"mode\":{\"kind\":\"derived\"}},{\"seg\":\"eu\",\"created_at\":1757500300,\"mode\":{\"kind\":\"sealed\",\"key_ct\":\"Lz65J3gKm8viFKdOxt2tMwd2YhL2Hqx6DiQ55Pbp0V0\"}},{\"seg\":\"staging\",\"created_at\":1757500200,\"mode\":{\"kind\":\"derived\"}}]}"
      }
    },
    {
      "id": "children-002",
      "description": "no children",
      "spec": "records.md#5.1",
      "op": "encode",
      "inputs": {
        "children": []
      },
      "expect": "success",
      "outputs": {
        "plaintext": "{\"v\":1,\"children\":[]}"
      }
    },
    {
      "id": "children-003",
      "description": "a record in any order parses to the canonical one",
      "spec": "records.md#5.1",
      "op": "parse",
      "inputs": {
        "plaintext": "{\"v\":1,\"children\":[{\"seg\": \"staging\", \"created_at\": 1757500200, \"mode\": {\"kind\": \"derived\"}}, {\"seg\": \"dev\", \"created_at\": 1757500100, \"mode\": {\"kind\": \"derived\"}}, {\"seg\": \"eu\", \"created_at\": 1757500300, \"mode\": {\"kind\": \"sealed\", \"key_ct\": \"Lz65J3gKm8viFKdOxt2tMwd2YhL2Hqx6DiQ55Pbp0V0\"}}]}"
      },
      "expect": "success",
      "outputs": {
        "plaintext": "{\"v\":1,\"children\":[{\"seg\":\"dev\",\"created_at\":1757500100,\"mode\":{\"kind\":\"derived\"}},{\"seg\":\"eu\",\"created_at\":1757500300,\"mode\":{\"kind\":\"sealed\",\"key_ct\":\"Lz65J3gKm8viFKdOxt2tMwd2YhL2Hqx6DiQ55Pbp0V0\"}},{\"seg\":\"staging\",\"created_at\":1757500200,\"mode\":{\"kind\":\"derived\"}}]}"
      }
    },
    {
      "id": "children-004",
      "description": "refused: version 0",
      "spec": "records.md#5.1",
      "op": "parse",
      "inputs": {
        "plaintext": "{\"v\":0,\"children\":[]}"
      },
      "expect": "unknown_version"
    },
    {
      "id": "children-005",
      "description": "refused: version 2",
      "spec": "records.md#5.1",
      "op": "parse",
      "inputs": {
        "plaintext": "{\"v\":2,\"children\":[]}"
      },
      "expect": "unknown_version"
    },
    {
      "id": "children-006",
      "description": "refused: a segment listed twice",
      "spec": "records.md#5.1",
      "op": "parse",
      "inputs": {
        "plaintext": "{\"v\":1,\"children\":[{\"seg\":\"a\",\"created_at\":1,\"mode\":{\"kind\":\"derived\"}},{\"seg\":\"a\",\"created_at\":2,\"mode\":{\"kind\":\"derived\"}}]}"
      },
      "expect": "bad_encoding"
    },
    {
      "id": "children-007",
      "description": "refused: an unknown field",
      "spec": "records.md#5.1",
      "op": "parse",
      "inputs": {
        "plaintext": "{\"v\":1,\"children\":[],\"server\":\"x\"}"
      },
      "expect": "bad_encoding"
    },
    {
      "id": "children-008",
      "description": "refused: an invalid segment",
      "spec": "records.md#5.1",
      "op": "parse",
      "inputs": {
        "plaintext": "{\"v\":1,\"children\":[{\"seg\":\"Bad\",\"created_at\":1,\"mode\":{\"kind\":\"derived\"}}]}"
      },
      "expect": "bad_encoding"
    },
    {
      "id": "children-009",
      "description": "refused: an unknown entry mode",
      "spec": "records.md#5.1",
      "op": "parse",
      "inputs": {
        "plaintext": "{\"v\":1,\"children\":[{\"seg\":\"a\",\"created_at\":1,\"mode\":{\"kind\":\"linked\"}}]}"
      },
      "expect": "bad_encoding"
    },
    {
      "id": "children-010",
      "description": "refused: not JSON",
      "spec": "records.md#5.1",
      "op": "parse",
      "inputs": {
        "plaintext": "children"
      },
      "expect": "bad_encoding"
    },
    {
      "id": "children-011",
      "description": "the owner signs frame(gv/v1/children, vault_id ‖ version ‖ SHA-256(ct))",
      "spec": "records.md#5.2",
      "op": "sign",
      "inputs": {
        "owner_node_key": "cde3e391e8ac271b784b0f8a03209cd109a651e1fdcb87cdc8b663667734602e",
        "version": 4,
        "ct": ""
      },
      "expect": "success",
      "outputs": {
        "signing_input": "67762f76312f6368696c6472656e00e9cb749994ea300f5bbf5285cba1056d00000000000000040fdf6e051144d4e157b554c858bd40310c054c82c747f0f66779731b57bc313b",
        "sig": "7856bb28523e64663d12c39ed8d2fd72541cd38cf7865543ee9b2f58b191ec7aa08642d5988ac596af7748017b0d1ca2124cbb9537cefc209c7258ea72a0b90d"
      }
    },
    {
      "id": "children-012",
      "description": "the owner opens its children record",
      "spec": "records.md#5.3",
      "op": "open",
      "inputs": {
        "owner_node_key": "cde3e391e8ac271b784b0f8a03209cd109a651e1fdcb87cdc8b663667734602e",
        "version": 4,
        "ct": "",
        "sig": "7856bb28523e64663d12c39ed8d2fd72541cd38cf7865543ee9b2f58b191ec7aa08642d5988ac596af7748017b0d1ca2124cbb9537cefc209c7258ea72a0b90d"
      },
      "expect": "success",
      "outputs": {
        "plaintext": "{\"v\":1,\"children\":[{\"seg\":\"dev\",\"created_at\":1757500100,\"mode\":{\"kind\":\"derived\"}},{\"seg\":\"eu\",\"created_at\":1757500300,\"mode\":{\"kind\":\"sealed\",\"key_ct\":\"Lz65J3gKm8viFKdOxt2tMwd2YhL2Hqx6DiQ55Pbp0V0\"}},{\"seg\":\"staging\",\"created_at\":1757500200,\"mode\":{\"kind\":\"derived\"}}]}"
      }
    },
    {
      "id": "children-013",
      "description": "signed by the secret writer key (what an append token holds)",
      "spec": "records.md#5.3",
      "op": "open",
      "inputs": {
        "owner_node_key": "cde3e391e8ac271b784b0f8a03209cd109a651e1fdcb87cdc8b663667734602e",
        "version": 4,
        "ct": "",
        "sig": "2d956330d12267d65f6740cf08716479cc5e6dfab15c3ea87533f26fa10861a22002369cc212142f98b308595e7a675005c3e4e31d7df11a13382ea5df29c30d"
      },
