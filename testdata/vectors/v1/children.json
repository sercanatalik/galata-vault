      "op": "open",
      "inputs": {
        "owner_node_key": "cde3e391e8ac271b784b0f8a03209cd109a651e1fdcb87cdc8b663667734602e",
        "version": 4,
        "ct": "",
        "sig": "ef2865b00199edf0465893267aed614eb7560347326a156762749077e4da99bce657e800b76c2166cd2c729a1d8ae020e4d79856bbe4a8f88e1ab069e270780b"
      },
      "expect": "bad_signature"
    },
    {
      "id": "children-016",
      "description": "sealed to another owner, signed by this one",
      "spec": "records.md#5.3",
      "op": "open",
      "inputs": {
        "owner_node_key": "cde3e391e8ac271b784b0f8a03209cd109a651e1fdcb87cdc8b663667734602e",
